# 80. Key Syntax Cheat Sheet

```python
# Create list
fruits = ["Apple", "Banana", "Orange"]

# Access
fruits[0]

# Negative indexing
fruits[-1]

# Change
fruits[0] = "Mango"

# Add
fruits.append("Grapes")

# Insert
fruits.insert(1, "Watermelon")

# Extend
fruits.extend(["Kiwi", "Papaya"])

# Remove by value
fruits.remove("Banana")

# Remove by index
fruits.pop(1)

# Delete
del fruits[0]

# Clear
fruits.clear()

# Length
len(fruits)

# Check item
"Apple" in fruits

# Slicing
fruits[1:3]

# Reverse
fruits.reverse()

# Sort
fruits.sort()

# Copy
new_fruits = fruits.copy()

# Count
fruits.count("Apple")

# Find index
fruits.index("Apple")

# List comprehension
numbers = [x for x in range(10)]

# Loop
for fruit in fruits:
    print(fruit)
```

